# WMC Inventar: Vorlage für .env (N-01, N-11)
# Keine echten Werte. .env nicht einchecken. Pflichtwerte für Docker Compose sind markiert.

# --- Anwendung --------------------------------------------------------------
# Entwicklungsmodus: 1 = an. Im Betrieb leer oder 0.
INVENTAR_DEBUG=0
# Pflicht: langer Zufallswert, z. B. python -c "import secrets; print(secrets.token_urlsafe(50))"
INVENTAR_SECRET_KEY=
# Pflicht: Adresse für Links in Mails und QR-Codes, ohne Schrägstrich am Ende
BASIS_URL=https://inventar.beispiel.test
# Weitere Hostnamen, kommagetrennt. Der Host aus BASIS_URL gilt immer.
INVENTAR_HOSTS=

# --- Datenbank --------------------------------------------------------------
# Pflicht für Docker Compose. Ohne Compose gilt DATABASE_URL, ohne beides SQLite.
POSTGRES_PASSWORD=
#DATABASE_URL=postgres://inventar:geheim@localhost:5432/inventar

# --- Mail -------------------------------------------------------------------
# Pflicht: Absender aller Mails
MAIL_ABSENDER=inventar@beispiel.test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORT=
SMTP_TLS=1
# Nur für Tests: legt jede Mail als Datei ab und versendet nichts.
MAIL_ABLAGE=

# --- Siegel (F-138) ---------------------------------------------------------
# Pflicht: Firmenzertifikat als PKCS#12. Ohne Siegel schließt kein Protokoll ab.
SIEGEL_DATEI=/srv/inventar-geheim/siegel.p12
SIEGEL_PASSWORT=

# --- HTTPS (N-01) -----------------------------------------------------------
# Pflicht: internes Zertifikat und Schlüssel für den Reverse Proxy
TLS_ZERTIFIKAT=/srv/inventar-geheim/zertifikat.pem
TLS_SCHLUESSEL=/srv/inventar-geheim/schluessel.pem
HTTPS_PORT=443
HTTP_PORT=80
# Ohne Compose: 1, wenn ein eigener Proxy davor steht, der X-Forwarded-For setzt.
INVENTAR_PROXY=

# --- Sicherung (N-06) -------------------------------------------------------
# Pflicht: Verzeichnis, das UrBackup erfasst
SICHERUNG_ZIEL=/srv/inventar-sicherung
DATEIABLAGE=

# --- Kennzahlen-Schnittstelle (F-105) ---------------------------------------
KENNZAHLEN_TOKEN=

# --- Startdaten (N-11) ------------------------------------------------------
# Für manage.py startdaten: das erste Admin-Konto. Passwort danach nicht hier stehen lassen.
ADMIN_EMAIL=
ADMIN_PASSWORT=

# --- Nur Entwicklung und Tests ----------------------------------------------
# Passwort aller Konten aus beispieldaten
BEISPIEL_PASSWORT=Beispiel-Passwort-2026
