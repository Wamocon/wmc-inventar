# WMC Inventar – Beispielumgebung (N-11)
# Keine echten Werte. Alle Variablen aus docs/TESTSCHNITTSTELLE.md Abschnitt 1.

# Entwicklungsmodus (1 = an, sonst aus)
INVENTAR_DEBUG=

# Django-Schlüssel (Pflicht ohne Entwicklungsmodus)
INVENTAR_SECRET_KEY=

# Datenbank (PostgreSQL im Betrieb, SQLite ohne Angabe)
#DATABASE_URL=postgres://inventar:inventar@db:5432/inventar
DATABASE_URL=

# Adresse für Links in Mails und QR-Codes, ohne Schrägstrich am Ende
BASIS_URL=http://127.0.0.1:8000

# Mailablage (jede Mail als Datei, statt Versand)
#MAIL_ABLAGE=var/mails
MAIL_ABLAGE=

# Dateiablage (Protokolle, Fotos, Anhänge, Grundrisse)
DATEIABLAGE=var/dateien

# Siegel (F-138)
#SIEGEL_P12=
#SIEGEL_PASSWORT=
SIEGEL_P12=
SIEGEL_PASSWORT=

# Kennzahlen-Schnittstelle (F-105)
KENNZAHLEN_TOKEN=

# Passwort aller Konten aus beispieldaten
BEISPIEL_PASSWORT=Beispiel-Passwort-2026
